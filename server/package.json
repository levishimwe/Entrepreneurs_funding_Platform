{
  "name": "alu-funding-server",
  "version": "0.1.0",
  "private": true,
  "description": "API for the ALU Graduate Entrepreneurship & Funding Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "db:test": "node scripts/db-test.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "seed": "node scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "samples": "node scripts/make-sample-documents.js",
    "documents:reverify": "node scripts/reverify-documents.js",
    "release": "node scripts/migrate.js up && node scripts/seed.js",
    "ocr:warm": "node scripts/warm-ocr.js",
    "storage:copy-to-s3": "node scripts/copy-uploads-to-s3.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 180000,
    "globalSetup": "./tests/globalSetup.js",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "./tests/setupEnv.js"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@napi-rs/canvas": "^1.0.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "pdfjs-dist": "^6.3.289",
    "sequelize": "^6.37.8",
    "tesseract.js": "^7.0.0",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
