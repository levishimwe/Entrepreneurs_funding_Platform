# ALU Ventures API — environment variables.
# Development: copy to server/.env and fill in. Production (Render): set the
# same keys in the service's Environment tab (render.yaml lists them).
# Never commit real values. The Vercel client needs no environment variables:
# client/vercel.json proxies /api/* to the Render service.

# --- App -------------------------------------------------------------------
NODE_ENV=development                 # production on Render
PORT=4000                            # Render sets PORT itself
CLIENT_URL=http://localhost:5173     # Render: https://your-project.vercel.app (comma-separate extra origins)
JWT_SECRET=                          # long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_HOURS=12
ALUMNI_EMAIL_DOMAINS=alueducation.com,alustudent.com   # graduate registration only
TRUST_PROXY=1                        # Render behind Vercel: 2
# Cookie flags. Defaults: Secure in production, SameSite=Lax (same-origin via the Vercel rewrite).
COOKIE_SECURE=
COOKIE_SAMESITE=

# --- Aiven MySQL (TLS required, certificate always verified) ----------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=                         # DB_PASS is also accepted; DB_PASSWORD wins if both are set
DB_SSL_CA=./certs/ca.pem             # development: CA file (git-ignored)
DB_CA_CERT=                          # production: the CA certificate's PEM text (or its base64), used when the file is absent
DB_CONNECT_TIMEOUT_MS=20000          # TLS connect timeout to Aiven

# --- File storage ------------------------------------------------------------
STORAGE_DRIVER=local                 # local (development) | s3 (production: Render's disk is ephemeral)
UPLOAD_DIR=./uploads                 # local driver only
S3_BUCKET=                           # private bucket, no public access
S3_ENDPOINT=                         # R2: https://<account-id>.r2.cloudflarestorage.com · Hetzner: https://fsn1.your-objectstorage.com
S3_REGION=auto                       # R2: auto · Hetzner: fsn1 / nbg1 / hel1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email -------------------------------------------------------------------
EMAIL_DRIVER=smtp                    # smtp (Nodemailer) | brevo | resend. Render free tier blocks SMTP: use brevo or resend
EMAIL_API_KEY=                       # Brevo or Resend API key (HTTPS providers only)
MAIL_FROM=                           # "ALU Ventures" <sender@example.org> — must be a verified sender/domain with the provider
SMTP_HOST=smtp.gmail.com             # smtp driver only (Gmail needs an App Password)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- AI document verification (Google Gemini) ----------------------------------
# With a key, Gemini reads each degree / RDB / RRA document and our rules check
# its answer; Tesseract OCR always runs too and takes over if Gemini fails.
# Free tier: Google may use submitted files to improve its products and human
# reviewers may read them; Google asks not to send personal data on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # stable, free tier, built for document parsing
VERIFIER=                            # gemini | ocr (default: gemini when GEMINI_API_KEY is set)
GEMINI_TIMEOUT_MS=45000              # per document; on timeout the OCR checks decide
GEMINI_CONCURRENCY=1                 # requests at a time (free-tier limits)
GEMINI_MIN_INTERVAL_MS=4000          # gap between requests
GEMINI_COOLDOWN_MS=60000             # pause after an HTTP 429 before trying Gemini again

# --- OCR -----------------------------------------------------------------------
OCR_POOL_SIZE=1                      # OCR threads; each holds ~150 MB. 1 on 512 MB instances
OCR_IDLE_MS=60000                    # an idle OCR thread exits after this many ms

# --- Seeded accounts (created/updated by `npm run seed` and on every Render boot)
# Required — the seed refuses to run without them. No default passwords.
# Passwords: at least 12 characters, including a letter and a number.
# Any domain is allowed here (the alumni-domain rule is for graduate sign-up
# only). These addresses are reserved: nobody can register with them, and the
# seed refuses one that already belongs to a graduate or investor account.
# Changing ADMIN_EMAIL moves the current admin to the new address on the next
# boot (or suspends the old admins if there were several): exactly one active admin.
ADMIN_EMAIL=                         # e.g. admin@example.org
ADMIN_PASSWORD=
STAFF1_EMAIL=
STAFF1_PASSWORD=
STAFF2_EMAIL=
STAFF2_PASSWORD=
# Optional display names
ADMIN_NAME=
STAFF1_NAME=
STAFF2_NAME=
